{
	"name": "qingyan",
	"version": "0.2.4",
	"private": true,
	"description": "面向内容站点的第一方评论后端。",
	"bin": {
		"qingyanctl": "dist/cli/main.js",
		"qyctl": "dist/cli/main.js"
	},
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"dev": "tsx scripts/dev.ts",
		"dev:api": "tsx watch src/server.ts",
		"dev:admin": "vite --config apps/admin/vite.config.ts",
		"build": "pnpm run clean && pnpm run build:admin && tsc -p tsconfig.build.json",
		"build:admin": "vite build --config apps/admin/vite.config.ts",
		"start": "node dist/server.js",
		"lint": "biome lint src tests scripts apps/admin package.json pnpm-workspace.yaml tsconfig.json tsconfig.build.json drizzle.config.ts vitest.config.ts playwright.config.ts biome.json components.json",
		"format": "biome format --write src tests scripts apps/admin package.json pnpm-workspace.yaml tsconfig.json tsconfig.build.json drizzle.config.ts vitest.config.ts playwright.config.ts biome.json components.json",
		"format:check": "biome format src tests scripts apps/admin package.json pnpm-workspace.yaml tsconfig.json tsconfig.build.json drizzle.config.ts vitest.config.ts playwright.config.ts biome.json components.json",
		"check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run config:check",
		"check:system": "pnpm run check && pnpm run test:system",
		"typecheck": "pnpm run typecheck:server && pnpm run typecheck:admin",
		"typecheck:server": "tsc --noEmit -p tsconfig.json",
		"typecheck:admin": "tsc --noEmit -p apps/admin/tsconfig.json",
		"test": "vitest run --config vitest.config.ts",
		"test:smoke": "tsx scripts/dev-smoke.ts",
		"test:smoke:commenter-email": "tsx scripts/commenter-reply-email-smoke.ts",
		"test:e2e": "playwright test",
		"test:system": "pnpm run test:smoke && pnpm run test:e2e",
		"test:updater": "bash tests/scripts/update-script.test.sh",
		"test:updater:real-git": "bash tests/scripts/update-script-real-git.test.sh",
		"config:check": "tsx src/config/check-config.ts config/qingyan.example.yml",
		"config:check:local": "tsx src/config/check-config.ts",
		"qingyan:upgrade": "tsx scripts/upgrade.ts",
		"request-metadata:backfill": "tsx scripts/request-metadata-backfill.ts",
		"ip-region:update": "tsx scripts/ip-region.ts update",
		"wp-comments": "tsx scripts/wp-comments.ts",
		"wp-comments:analyze": "tsx scripts/wp-comments.ts analyze",
		"wp-comments:convert": "tsx scripts/wp-comments.ts convert",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@fastify/cookie": "^11.0.2",
		"@hookform/resolvers": "^5.4.0",
		"@radix-ui/react-label": "^2.1.9",
		"@radix-ui/react-separator": "^1.1.9",
		"@radix-ui/react-slot": "^1.2.5",
		"@radix-ui/themes": "^3.3.0",
		"@tanstack/react-query": "^5.101.0",
		"better-sqlite3": "^12.10.0",
		"bullmq": "^5.78.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"fast-xml-parser": "^5.8.0",
		"fastify": "^5.8.5",
		"fastify-plugin": "^5.1.0",
		"ioredis": "^5.11.1",
		"lucide-react": "^1.17.0",
		"nodemailer": "^8.0.10",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-hook-form": "^7.78.0",
		"react-router": "^7.15.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"ts-ip2region2": "^1.5.0",
		"tw-animate-css": "^1.4.0",
		"ua-parser-js": "^2.0.10",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@playwright/test": "^1.60.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^25.9.2",
		"@types/nodemailer": "^8.0.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"drizzle-kit": "^0.31.10",
		"node-gyp": "^12.4.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	}
}
